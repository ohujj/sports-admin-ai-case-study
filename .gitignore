# Never include executable projects, private records, credentials, dumps, or raw logs.
/app/
/src/
/.venv/
/start*.ps1
/requirements*.txt
.security-local/
private/
notes/
docs/ai-review/
VERIFICATION.md
.env
.env.*
*.log
*.pem
*.key
*.p12
*.pfx
*.db
*.sqlite*
*.py
*.py[cod]
__pycache__/
