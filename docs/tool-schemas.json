[
  {
    "type": "function",
    "name": "read_programs",
    "description": "조회 가능한 강습 이름과 코드를 찾는다. search_keyword는 강습명/코드 검색어, 없으면 null. 최대20개 표시하며 truncated=true면 전체가 아니다.",
    "strict": true,
    "parameters": {
      "type": "object",
      "properties": {
        "search_keyword": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "search_keyword"
      ],
      "additionalProperties": false
    }
  },
  {
    "type": "function",
    "name": "read_retention_declines",
    "description": "여러 강습의 이전 구간 대비 현재 유지율 하락을 %p로 비교한다. 강습 수 제한 없이 분석한다. 빈 코드 배열이면 검색어/전체 범위를 끝까지 분석한다. 모델용 items는 최대10개 미리보기이며 전체 결과는 로컬 화면에 표시한다.",
    "strict": true,
    "parameters": {
      "type": "object",
      "properties": {
        "base_month": {
          "type": "string",
          "description": "기준 월 YYYY-MM"
        },
        "target_month": {
          "type": "string",
          "description": "바로 다음 비교 월 YYYY-MM"
        },
        "program_codes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "min_drop_pp": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "search_keyword": {
          "type": "string",
          "description": "코드 지정 시 빈 문자열. 전체 중 강습명/코드로 좁힐 때만 검색어."
        }
      },
      "required": [
        "base_month",
        "target_month",
        "program_codes",
        "min_drop_pp",
        "search_keyword"
      ],
      "additionalProperties": false
    }
  },
  {
    "type": "function",
    "name": "read_retention_summary",
    "description": "한 강습의 전월 대비 다음 달 유지율과 인원을 조회한다.",
    "strict": true,
    "parameters": {
      "type": "object",
      "properties": {
        "program_code": {
          "type": "string",
          "description": "read_programs에서 확인한 강습 코드"
        },
        "base_month": {
          "type": "string",
          "description": "기준 월 YYYY-MM"
        },
        "target_month": {
          "type": "string",
          "description": "바로 다음 비교 월 YYYY-MM"
        }
      },
      "required": [
        "program_code",
        "base_month",
        "target_month"
      ],
      "additionalProperties": false
    }
  },
  {
    "type": "function",
    "name": "show_retention_members",
    "description": "유지/미유지/전체 명단을 로컬 화면에 표시한다. 회원정보를 모델에는 반환하지 않는다.",
    "strict": true,
    "parameters": {
      "type": "object",
      "properties": {
        "program_code": {
          "type": "string",
          "description": "read_programs에서 확인한 강습 코드"
        },
        "base_month": {
          "type": "string",
          "description": "기준 월 YYYY-MM"
        },
        "target_month": {
          "type": "string",
          "description": "바로 다음 비교 월 YYYY-MM"
        },
        "status": {
          "type": "string",
          "enum": [
            "all",
            "retained",
            "not_retained"
          ]
        }
      },
      "required": [
        "program_code",
        "base_month",
        "target_month",
        "status"
      ],
      "additionalProperties": false
    }
  }
]